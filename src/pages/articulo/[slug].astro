---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(a => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content: ContentES } = await article.render();

const allEN = await getCollection('articles-en');
const articleEN = allEN.find(a => a.slug === article.slug);
const ContentEN = articleEN ? (await articleEN.render()).Content : null;

const { title, author, date, section, tag, image, excerpt, photo_credit, title_en, excerpt_en, tag_en } = article.data;
const esDate = new Date(date).toLocaleDateString('es-AR', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });
const enDate = new Date(date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
const sectionLabels: Record<string, {es: string, en: string}> = {
  cannabis:  { es: 'Cannabis',         en: 'Cannabis' },
  plantas:   { es: 'Plantas',          en: 'Plants' },
  ciencia:   { es: 'Ciencia',          en: 'Science' },
  derechos:  { es: 'Derechos Humanos', en: 'Human Rights' },
};
const secLabel = sectionLabels[section] ?? { es: section, en: section };
---
<Layout title={title} description={excerpt}>
  <div class="article-page">
    <div class="article-meta-top">
      <a class="back-link" href={`/secciones/${section}`}>
        <span class="es-only">← {secLabel.es}</span>
        <span class="en-only">← {secLabel.en}</span>
      </a>
      <span class="tag-label es-only">{tag}</span>
      {tag_en && <span class="tag-label en-only">{tag_en}</span>}
    </div>
    <h1 class="article-headline">
      <span class="es-only">{title}</span>
      {title_en && <span class="en-only">{title_en}</span>}
    </h1>
    <p class="article-excerpt-lead">
      <span class="es-only">{excerpt}</span>
      {excerpt_en && <span class="en-only">{excerpt_en}</span>}
    </p>
    <div class="article-byline">
      <span class="es-only">Por {author} · {esDate}</span>
      <span class="en-only">By {author === 'La Redacción' ? 'The Editorial Team' : author} · {enDate}</span>
    </div>
    {image && (
      <figure class="article-hero-figure">
        <img class="article-hero-img" src={image} alt={title} />
        {photo_credit && <figcaption class="photo-credit">{photo_credit}</figcaption>}
      </figure>
    )}
    {ContentEN ? (
      <>
        <div class="article-body es-only"><ContentES /></div>
        <div class="article-body en-only"><ContentEN /></div>
      </>
    ) : (
      <>
        <p class="lang-note en-only">This article is available in Spanish only.</p>
        <div class="article-body"><ContentES /></div>
      </>
    )}
    <div class="article-share" aria-label="Compartir / Share">
      <span class="share-label">
        <span class="es-only">Compartir</span>
        <span class="en-only">Share</span>
      </span>
      <button type="button" class="share-btn" data-share="native" hidden>
        <span class="es-only">Compartir</span>
        <span class="en-only">Share</span>
      </button>
      <a class="share-btn" data-share="whatsapp" href="#" target="_blank" rel="noopener">WhatsApp</a>
      <a class="share-btn" data-share="twitter" href="#" target="_blank" rel="noopener">X · Twitter</a>
      <button type="button" class="share-btn" data-share="instagram">Instagram</button>
      <button type="button" class="share-btn" data-share="copy">
        <span class="es-only">Copiar enlace</span>
        <span class="en-only">Copy link</span>
      </button>
      <span class="share-toast" data-share="toast" aria-live="polite" hidden></span>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    const url = window.location.href;
    const title = document.title;
    const text = title + ' — ' + url;

    const native = document.querySelector('.share-btn[data-share="native"]');
    if (native && navigator.share) {
      native.hidden = false;
      native.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }

    const wa = document.querySelector('.share-btn[data-share="whatsapp"]');
    if (wa) wa.setAttribute('href', 'https://wa.me/?text=' + encodeURIComponent(text));

    const tw = document.querySelector('.share-btn[data-share="twitter"]');
    if (tw) tw.setAttribute('href', 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(url));

    document.querySelectorAll('.share-btn[data-share="copy"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const original = btn.innerHTML;
        try {
          await navigator.clipboard.writeText(url);
          btn.innerHTML = '<span class="es-only">¡Copiado!</span><span class="en-only">Copied!</span>';
        } catch (e) {
          btn.innerHTML = '<span class="es-only">Error</span><span class="en-only">Error</span>';
        }
        setTimeout(() => { btn.innerHTML = original; }, 1800);
      });
    });

    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    const toast = document.querySelector('.share-toast[data-share="toast"]');
    const showToast = (esText, enText) => {
      if (!toast) return;
      toast.innerHTML = '<span class="es-only">' + esText + '</span><span class="en-only">' + enText + '</span>';
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 3500);
    };

    document.querySelectorAll('.share-btn[data-share="instagram"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(url); } catch (e) {}
        if (isMobile) {
          showToast('Enlace copiado — pegá en tu Instagram', 'Link copied — paste it in Instagram');
          window.location.href = 'instagram://';
        } else {
          showToast('Enlace copiado — abrí Instagram en tu teléfono y pegalo', 'Link copied — open Instagram on your phone and paste it');
        }
      });
    });
  })();
</script>

<style>
  .article-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }
  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .back-link {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #666;
    text-decoration: none;
  }
  .back-link:hover { color: var(--black); }
  .tag-label {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    background: var(--black);
    padding: 2px 8px;
  }
  .article-headline {
    font-family: var(--font-serif);
    font-size: clamp(26px, 5vw, 44px);
    font-weight: bold;
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .article-excerpt-lead {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.7;
    color: #444;
    border-left: 3px solid var(--black);
    padding-left: 16px;
    margin-bottom: 16px;
  }
  .article-byline {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 1px;
    color: #999;
    margin-bottom: 28px;
  }
  .article-hero-figure {
    margin: 0 0 36px;
  }
  .article-hero-img {
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: contain;
    background: #f4f4f0;
    border: 1px solid var(--gray-light);
    display: block;
  }
  .photo-credit {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 1px;
    color: #aaa;
    padding: 5px 0 0;
    text-align: right;
  }
  .article-body {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.8;
    color: #222;
  }
  .article-body :global(h2) {
    font-size: 20px;
    font-weight: bold;
    margin: 36px 0 12px;
    border-top: 1px solid var(--gray-light);
    padding-top: 24px;
  }
  .article-body :global(p) { margin-bottom: 20px; }
  .article-body :global(em) { font-style: italic; }
  .article-body :global(strong) { font-weight: bold; }
  .article-body :global(ul) { padding-left: 20px; margin-bottom: 20px; }
  .article-body :global(li) { margin-bottom: 8px; }
  .lang-note {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 24px;
  }
  .article-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 56px;
    padding: 18px 0;
    border-top: 2px solid var(--black);
    border-bottom: 2px solid var(--black);
  }
  .share-label {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #666;
    margin-right: 8px;
  }
  .share-btn {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--black);
    background: transparent;
    border: 1.5px solid var(--black);
    padding: 8px 14px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background 0.1s ease, color 0.1s ease;
  }
  .share-btn:hover,
  .share-btn:focus {
    background: var(--black);
    color: var(--white);
    outline: none;
  }
  .share-btn[hidden] { display: none; }
  .share-toast {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--white);
    background: var(--black);
    padding: 8px 14px;
    flex-basis: 100%;
    text-align: center;
  }
  .share-toast[hidden] { display: none; }
  @media (max-width: 600px) {
    .article-share { gap: 6px; }
    .share-label { display: none; }
    .share-btn {
      font-size: 9px;
      letter-spacing: 1px;
      padding: 7px 9px;
    }
  }
</style>

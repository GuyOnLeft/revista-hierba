---
import { getCollection } from 'astro:content';
import SectionPage from '../../components/SectionPage.astro';

const all = await getCollection('articles');
const articles = all
  .filter(a => a.data.section === 'derechos')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map(a => ({
    tag: a.data.tag,
    tag_en: a.data.tag_en,
    title: a.data.title,
    title_en: a.data.title_en,
    excerpt: a.data.excerpt,
    excerpt_en: a.data.excerpt_en,
    byline: a.data.author,
    img: a.data.image,
    slug: a.slug,
  }));
---
<SectionPage
  section="Derechos Humanos"
  sectionSlug="derechos"
  sectionKey="derechos"
  description="El acceso a la salud, la criminalización de usuarios, y la lucha por los derechos del paciente."
  articles={articles}
/>

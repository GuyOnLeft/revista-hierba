---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { section: 'cannabis' } },
    { params: { section: 'plantas' } },
    { params: { section: 'ciencia' } },
    { params: { section: 'derechos' } },
  ];
}

const sectionNames: Record<string, string> = {
  cannabis: 'Cannabis',
  plantas: 'Plantas Medicinales',
  ciencia: 'Ciencia',
  derechos: 'Derechos Humanos',
};

const { section } = Astro.params;
const sectionName = sectionNames[section];

const all = await getCollection('articles');
const articles = all
  .filter(a => a.data.section === section)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-AR', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title={sectionName}>
  <div class="page-header">
    <a class="back-link" href={`/secciones/${section}`}>← {sectionName}</a>
    <h1 class="page-title">Todos los artículos</h1>
    <p class="article-count">{articles.length} artículo{articles.length !== 1 ? 's' : ''}</p>
  </div>
  <div class="listing-grid">
    {articles.map(article => (
      <article class="listing-card">
        <div class="card-img">
          <img src={article.data.image} alt={article.data.title} loading="lazy" />
        </div>
        <div class="card-body">
          <span class="tag">{article.data.tag}</span>
          <h2 class="card-title">{article.data.title}</h2>
          <p class="card-excerpt">{article.data.excerpt}</p>
          <div class="card-meta">
            <span class="card-author">{article.data.author}</span>
            <span class="card-date">{formatDate(article.data.date)}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    padding: 32px 40px 28px;
    border-bottom: 2px solid var(--black);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .back-link {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gray-mid);
    text-decoration: none;
  }
  .back-link:hover { color: var(--black); }
  .page-title {
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -0.5px;
    line-height: 1.05;
  }
  .article-count {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gray-mid);
  }
  .listing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 2px solid var(--black);
  }
  .listing-card {
    border-right: 1px solid var(--gray-light);
    border-bottom: 1px solid var(--gray-light);
    display: flex;
    flex-direction: column;
  }
  .listing-card:nth-child(3n) { border-right: none; }
  .card-img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--gray-light);
  }
  .card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    background: var(--black);
    padding: 2px 8px;
    align-self: flex-start;
  }
  .card-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    font-family: var(--font-sans);
  }
  .card-excerpt {
    font-size: 12px;
    line-height: 1.65;
    color: #555;
    font-family: var(--font-serif);
    flex: 1;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--gray-light);
  }
  .card-author {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--gray-mid);
    text-transform: uppercase;
  }
  .card-date {
    font-family: var(--font-sans);
    font-size: 9px;
    color: #bbb;
  }
  @media (max-width: 900px) {
    .listing-grid { grid-template-columns: repeat(2, 1fr); }
    .listing-card:nth-child(3n) { border-right: 1px solid var(--gray-light); }
    .listing-card:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 500px) {
    .listing-grid { grid-template-columns: 1fr; }
    .listing-card { border-right: none !important; }
    .page-header { padding: 24px 20px; }
  }
</style>

---
import { getCollection } from 'astro:content';
import SectionPage from '../../components/SectionPage.astro';

const all = await getCollection('articles');
const articles = all
  .filter(a => a.data.section === 'plantas')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map(a => ({
    tag: a.data.tag,
    title: a.data.title,
    excerpt: a.data.excerpt,
    byline: a.data.author,
    img: a.data.image,
    slug: a.slug,
  }));
---
<SectionPage
  section="Plantas Medicinales"
  sectionSlug="plantas"
  sectionKey="plantas"
  description="Etnobotánica, medicina tradicional, y la ciencia detrás de las plantas que curan."
  articles={articles}
/>

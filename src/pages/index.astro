---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import SectionPreviews from '../components/SectionPreviews.astro';
import Newsletter from '../components/Newsletter.astro';
---
<Layout description="Revista Hierba — Periodismo independiente sobre cannabis, plantas medicinales, ciencia y derechos humanos.">
  <Hero />
  <ArticleGrid />
  <div class="ver-todos-home">
    <a href="/articulos" class="ver-todos-link">
      <span class="es-only">Ver todos los artículos →</span>
      <span class="en-only">See all articles →</span>
    </a>
  </div>
  <SectionPreviews />
  <Newsletter />
</Layout>

<style>
  .ver-todos-home {
    padding: 24px 40px;
    border-bottom: 2px solid var(--black);
    background: var(--white);
  }
  .ver-todos-link {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--black);
    text-decoration: none;
    border-bottom: 1px solid var(--black);
    padding-bottom: 2px;
  }
  .ver-todos-link:hover { color: var(--gray-mid); border-color: var(--gray-mid); }
</style>

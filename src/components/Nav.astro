---
const pathname = Astro.url.pathname;
---
<nav>
  <div class="nav-logo">
    <a href="/"><img src="/hierba-mark.png" alt="Revista Hierba" /></a>
  </div>
  <div class="nav-links">
    <a href="/editorial"
       class:list={[{ active: pathname.startsWith('/editorial') }]}
       data-i18n="nav.editorial">Editorial</a>
    <div class:list={['nav-dropdown', { active: pathname.startsWith('/secciones') }]}>
      <span class="nav-dropdown-trigger" data-i18n="nav.sections">Secciones ▾</span>
      <div class="dropdown-menu">
        <a href="/secciones/cannabis">Cannabis</a>
        <a href="/secciones/plantas"><span class="es-only">Plantas Medicinales</span><span class="en-only">Medicinal Plants</span></a>
        <a href="/secciones/ciencia"><span class="es-only">Ciencia</span><span class="en-only">Science</span></a>
        <a href="/secciones/derechos"><span class="es-only">Derechos Humanos</span><span class="en-only">Human Rights</span></a>
      </div>
    </div>
    <a href="/nosotros"
       class:list={[{ active: pathname.startsWith('/nosotros') }]}
       data-i18n="nav.about">Nosotros</a>
    <a href="/contacto"
       class:list={[{ active: pathname.startsWith('/contacto') }]}
       data-i18n="nav.contact">Contacto</a>
  </div>
  <a class="nav-instagram" href="https://www.instagram.com/hierba.revista?igsh=MWp3bmxvemdtbnR1aw==" target="_blank" rel="noopener" aria-label="Instagram">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    </svg>
  </a>
  <div class="lang-toggle">
    <span data-lang="es" class="active">ES</span>
    <span class="sep">/</span>
    <span data-lang="en">EN</span>
  </div>
  <button class="hamburger" aria-label="Abrir menú" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <a href="/editorial" class:list={[{ active: pathname.startsWith('/editorial') }]} data-i18n="nav.editorial">Editorial</a>
  <div class="mobile-section-group">
    <div class="mobile-section-label" data-i18n="nav.sections">Secciones</div>
    <a href="/secciones/cannabis">Cannabis</a>
    <a href="/secciones/plantas"><span class="es-only">Plantas Medicinales</span><span class="en-only">Medicinal Plants</span></a>
    <a href="/secciones/ciencia"><span class="es-only">Ciencia</span><span class="en-only">Science</span></a>
    <a href="/secciones/derechos"><span class="es-only">Derechos Humanos</span><span class="en-only">Human Rights</span></a>
  </div>
  <a href="/nosotros" class:list={[{ active: pathname.startsWith('/nosotros') }]} data-i18n="nav.about">Nosotros</a>
  <a href="/contacto" class:list={[{ active: pathname.startsWith('/contacto') }]} data-i18n="nav.contact">Contacto</a>
</div>

<script>
  const hamburger = document.querySelector('.hamburger') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu');
  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(!!isOpen));
    hamburger.classList.toggle('open', !!isOpen);
  });
</script>

<style>
  nav {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 32px;
    padding: 8px 40px 8px 0;
    border-bottom: 2px solid var(--black);
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 56px;
  }
  .nav-links {
    display: flex;
    gap: 28px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .nav-links a:hover { border-bottom: 1px solid var(--black); }
  .nav-links a.active { border-bottom: 1px solid var(--black); }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
    cursor: pointer;
    padding-bottom: 10px;
  }
  .nav-dropdown-trigger {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--black);
    user-select: none;
  }
  .nav-dropdown.active .nav-dropdown-trigger,
  .nav-dropdown:hover .nav-dropdown-trigger { border-bottom: 1px solid var(--black); }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: -16px;
    background: var(--white);
    border: 2px solid var(--black);
    min-width: 200px;
    z-index: 200;
    flex-direction: column;
  }
  .nav-dropdown:hover .dropdown-menu { display: flex; }
  .dropdown-menu a {
    display: block;
    padding: 10px 16px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--black);
    text-decoration: none;
    border-bottom: 1px solid var(--gray-light);
  }
  .dropdown-menu a:last-child { border-bottom: none; }
  .dropdown-menu a:hover { background: var(--black); color: var(--white); }

  /* Logo */
  .nav-logo { margin-left: 0; }
  .nav-logo a { display: block; }
  .nav-logo img {
    height: 74px;
    width: auto;
    margin: -16px 0;
    display: block;
    border: none;
    outline: none;
  }

  /* Lang toggle */
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .lang-toggle [data-lang] { cursor: pointer; padding: 2px 8px; }
  .lang-toggle [data-lang].active { background: var(--black); color: var(--white); }
  .lang-toggle .sep { color: #ccc; }
  .nav-instagram {
    color: var(--black);
    display: flex;
    align-items: center;
    transition: opacity 0.15s;
    margin-left: auto;
  }
  .nav-instagram:hover { opacity: 0.5; }

  /* Hamburger button */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: 8px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--black);
    transition: transform 0.2s, opacity 0.2s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu drawer */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--white);
    border-bottom: 2px solid var(--black);
    position: sticky;
    top: 56px;
    z-index: 99;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu > a {
    padding: 14px 24px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--black);
    text-decoration: none;
    border-bottom: 1px solid var(--gray-light);
  }
  .mobile-menu > a.active { font-weight: 700; }
  .mobile-menu > a:last-child { border-bottom: none; }
  .mobile-section-group {
    border-bottom: 1px solid var(--gray-light);
  }
  .mobile-section-label {
    padding: 14px 24px 8px;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gray-mid);
  }
  .mobile-section-group a {
    display: block;
    padding: 10px 24px 10px 36px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--black);
    text-decoration: none;
    border-top: 1px solid var(--gray-light);
  }
  .mobile-section-group a:hover { background: #f5f5f5; }

  @media (max-width: 600px) {
    nav { gap: 12px; padding: 8px 16px; }
    .nav-links { display: none; }
    .nav-logo img { height: 52px; margin: -8px 0; }
    .hamburger { display: flex; }
  }
</style>

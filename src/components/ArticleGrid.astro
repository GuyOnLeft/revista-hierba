---
import { getCollection } from 'astro:content';

const all = await getCollection('articles');
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = sorted;
const secondary = rest.slice(0, 2);
---
<div class="section-label" data-i18n="featured.label">Artículos Destacados</div>
<div class="article-grid">
  <a class="article-featured" href={`/articulo/${featured.slug}`}>
    <div class="img-wrapper">
      <img src={featured.data.image} alt={featured.data.title} />
    </div>
    <span class="tag es-only">{featured.data.tag}</span>
    {featured.data.tag_en && <span class="tag en-only">{featured.data.tag_en}</span>}
    <h2 class="article-title">
      <span class="es-only">{featured.data.title}</span>
      {featured.data.title_en && <span class="en-only">{featured.data.title_en}</span>}
    </h2>
    <p class="article-excerpt">
      <span class="es-only">{featured.data.excerpt}</span>
      {featured.data.excerpt_en && <span class="en-only">{featured.data.excerpt_en}</span>}
    </p>
    <p class="article-byline">
      <span class="es-only">Por {featured.data.author} · {new Date(featured.data.date).toLocaleDateString('es-AR', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' })}</span>
      <span class="en-only">By {featured.data.author === 'La Redacción' ? 'The Editorial Team' : featured.data.author} · {new Date(featured.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' })}</span>
    </p>
  </a>
  <div class="article-stack">
    {secondary.map(a => (
      <a class="article-small" href={`/articulo/${a.slug}`}>
        <div class="img-wrapper">
          <img src={a.data.image} alt={a.data.title} />
        </div>
        <span class="tag es-only">{a.data.tag}</span>
        {a.data.tag_en && <span class="tag en-only">{a.data.tag_en}</span>}
        <h3 class="article-title-sm">
          <span class="es-only">{a.data.title}</span>
          {a.data.title_en && <span class="en-only">{a.data.title_en}</span>}
        </h3>
        <p class="article-byline">
          <span class="es-only">Por {a.data.author} · {new Date(a.data.date).toLocaleDateString('es-AR', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' })}</span>
          <span class="en-only">By {a.data.author === 'La Redacción' ? 'The Editorial Team' : a.data.author} · {new Date(a.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </p>
      </a>
    ))}
  </div>
</div>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    background: var(--white);
    border-top: 2px solid var(--black);
    border-bottom: 2px solid var(--black);
  }
  .article-featured {
    display: block;
    padding: 32px;
    border-right: 1px solid var(--gray-light);
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }
  .article-featured:hover { background: #fafafa; }
  .img-wrapper {
    overflow: hidden;
    border: 1px solid var(--gray-light);
    margin-bottom: 18px;
  }
  .article-featured .img-wrapper { aspect-ratio: 16 / 9; }
  .article-small .img-wrapper { aspect-ratio: 3 / 2; margin-bottom: 12px; }
  .img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .article-stack { display: flex; flex-direction: column; }
  .article-small {
    display: block;
    padding: 22px 24px;
    border-bottom: 1px solid var(--gray-light);
    flex: 1;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }
  .article-small:last-child { border-bottom: none; }
  .article-small:hover { background: #fafafa; }
  .tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    background: var(--black);
    padding: 2px 8px;
    margin-bottom: 9px;
  }
  .article-title {
    font-size: 22px;
    font-weight: bold;
    line-height: 1.2;
    margin-bottom: 10px;
  }
  .article-title-sm {
    font-size: 15px;
    font-weight: bold;
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .article-excerpt {
    font-size: 13px;
    line-height: 1.65;
    color: #444;
    margin: 8px 0 12px;
  }
  .article-byline {
    font-family: var(--font-sans);
    font-size: 10px;
    color: #999;
    letter-spacing: 1px;
  }
  @media (max-width: 700px) {
    .article-grid { grid-template-columns: 1fr; }
    .article-featured { border-right: none; border-bottom: 1px solid var(--gray-light); }
  }
</style>
